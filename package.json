{
  "name": "portfolio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "echo '\\n  Local preview: http://localhost:3000/\\n' && next dev",
    "prebuild": "node scripts/generate-rss.mjs",
    "build": "next build",
    "prebuild:pages": "node scripts/generate-rss.mjs",
    "build:pages": "GITHUB_PAGES=true next build",
    "start": "echo '\\n  Production preview: http://localhost:3000/\\n  (Static export — use npm run dev for development)\\n' && npx serve@latest out -l 3000",
    "lint": "next lint",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d out --nojekyll"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.12.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
